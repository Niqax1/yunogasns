{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yunogasns",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",

  // public/ の中身は静的アセットとして配信する（無料・無制限で、Workerのリクエスト数にも数えられない）。
  // /api/* だけがWorkerを起動し、それ以外の存在しないパス（/p/123 など）には index.html を返す。
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // 本番のデータベース（`npx wrangler d1 create yunogasns` で作成したもの）。
  // 手元で動かすとき（npm run dev）は、これとは別に手元専用のデータベースが使われる。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yunogasns",
      "database_id": "29d52ddc-6298-4b3b-a28e-29bf06b44338"
    }
  ],

  // 連投対策。投稿とコメントは合わせて、同じIPから60秒あたり10回まで。いいねは30回まで。
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "LIKE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // 1時間ごとに7日を過ぎた投稿とそのコメントを削除する（時刻はUTC）。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
