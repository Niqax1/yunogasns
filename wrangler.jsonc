{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yunogasns",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",

  // public/ の中身は静的アセットとして配信する（無料・無制限で、Workerのリクエスト数にも数えられない）。
  // /api/* と画像の /media/* だけがWorkerを起動し、それ以外の存在しないパス（/p/123 など）には index.html を返す。
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },

  // 本番のデータベース（`npx wrangler d1 create yunogasns` で作成したもの）。
  // 手元で動かすとき（npm run dev）は、これとは別に手元専用のデータベースが使われる。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yunogasns",
      "database_id": "29d52ddc-6298-4b3b-a28e-29bf06b44338"
    }
  ],

  // 投稿の写真とアイコン画像の保存先（`npx wrangler kv namespace create yunogasns-media` で作成したもの）
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "dd40699591b74a88bd8aefb2aeeafd5b"
    }
  ],

  // 連投対策。投稿とコメントは合わせて1人60秒あたり10回まで、いいねは30回まで。
  // ログインの試行は同じIPから60秒あたり10回まで。
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "LIKE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // 1時間ごとに7日を過ぎた投稿とそのコメント・いいね、期限切れのログイン情報を削除する（時刻はUTC）。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // 通知（Web Push）の送り主を証明する鍵の公開側。秘密側の VAPID_PRIVATE_KEY は、
  // 手元では .dev.vars に、本番では秘密情報として設定する（README の「通知を使えるようにする」参照）
  "vars": {
    "VAPID_PUBLIC_KEY": "BOwEbOEs7oRmmQUxROisjwu6gNDfon7dAuKfcItTXkf4b7R-t1DkBmsqL5E1LiXRnyK4HhXYMQRXpkPhSsnfJUI"
  },

  "observability": {
    "enabled": true
  }
}
