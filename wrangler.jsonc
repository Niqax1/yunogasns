{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yunogasns",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",

  // public/ の中身は静的アセットとして配信する（無料・無制限で、Workerのリクエスト数にも数えられない）。
  // /api/* だけがWorkerを起動し、それ以外の存在しないパス（/p/123 など）には index.html を返す。
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // database_id は初回の `wrangler deploy` で自動作成・追記される（README参照）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yunogasns"
    }
  ],

  // 投稿・コメントの連投対策。同じIPから60秒あたり10回まで。
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // 1時間ごとに7日を過ぎた投稿とそのコメントを削除する（時刻はUTC）。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
